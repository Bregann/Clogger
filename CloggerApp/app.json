{
  "expo": {
    "assetBundlePatterns": [
      "**/*"
    ],
    "name": "CloggerApp",
    "slug": "CloggerApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#e2e3db"
      },
      "package": "com.bregan.CloggerApp"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/nunito/Nunito_400Regular.ttf"
          ]
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#e2e3db"
        }
      ],
      "expo-secure-store",
      "expo-build-properties",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "32be621d-61e8-4e40-973f-63a38f7ae4cb"
      },
      "ApiUrl": "https://cloggerapi.bregan.me"
    }
  }
}
